{
  "name": "agent-ready-site-template",
  "version": "1.0.0",
  "private": true,
  "description": "A fast, accessible personal website template with first-class machine-readable publishing.",
  "scripts": {
    "predev": "npm run generate:machine",
    "dev": "next dev -H 127.0.0.1",
    "prebuild": "npm run generate:machine",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "pretest:e2e": "npm run generate:machine && npm run build",
    "test:e2e": "playwright test",
    "generate:machine": "tsx scripts/generate-machine-content.ts",
    "check:machine": "tsx scripts/generate-machine-content.ts --check",
    "audit": "npm audit --audit-level=high",
    "check": "npm run check:machine && npm run lint && npm run typecheck && npm run test:unit && npm run build"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10 <12"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "lucide-react": "^0.577.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint-react/eslint-plugin": "5.18.6",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.2",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.9.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "packageManager": "npm@11.12.1"
}
